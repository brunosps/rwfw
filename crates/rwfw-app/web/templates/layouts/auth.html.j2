{% extends "layouts/base.html.j2" %}
{% block body %}
<div class="min-h-screen lg:grid lg:grid-cols-2">
  <div class="relative hidden lg:flex flex-col justify-between overflow-hidden bg-slate-900 px-12 py-14 text-slate-100">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-slate-800 via-slate-900 to-black"></div>
    <div class="pointer-events-none absolute -top-24 -left-24 h-96 w-96 rounded-full bg-indigo-500/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 -right-16 h-96 w-96 rounded-full bg-slate-400/10 blur-3xl"></div>

    <div class="relative">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">Welcome to</p>
      <h1 class="mt-4 font-serif text-5xl font-semibold leading-tight text-white">{{ app_title | default(value="RWFW") }}</h1>
    </div>

    <div class="relative max-w-sm">
      <p class="text-lg leading-relaxed text-slate-300">A calm, considered place to write, publish, and sell. Sign in to pick up right where you left off.</p>
    </div>

    <div class="relative text-sm text-slate-500">
      &copy; {{ app_title | default(value="RWFW") }}
    </div>
  </div>

  <div class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center lg:hidden">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Welcome to</p>
        <h1 class="mt-2 font-serif text-3xl font-semibold text-slate-900">{{ app_title | default(value="RWFW") }}</h1>
      </div>
      <x-flash :flash="flash" />
      {% block content %}{% endblock %}
    </div>
  </div>
</div>
{% endblock %}
