{% extends "layouts/base.html.j2" %}
{% block body %}
<div class="min-h-screen bg-stone-50 text-stone-900">
  <header class="sticky top-0 z-30 border-b border-stone-200 bg-stone-50/90 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
      <a href="/" class="font-serif text-2xl font-semibold tracking-tight text-stone-900 transition-colors hover:text-indigo-700">
        {{ app_title | default(value="RWFW") }}
      </a>
      <nav class="flex items-center gap-6 text-xs font-medium uppercase tracking-[0.12em] text-stone-500">
        <a href="/" class="transition-colors hover:text-indigo-700">Home</a>
        <a href="/blog" class="transition-colors hover:text-indigo-700">Blog</a>
        {% if auth and auth.user %}
          <span class="hidden text-stone-400 sm:inline">/</span>
          <span class="text-stone-700">{{ auth.user.name }}</span>
        {% else %}
          <span class="hidden text-stone-400 sm:inline">/</span>
          <a href="/auth/login" class="text-indigo-700 transition-colors hover:text-indigo-800">Sign in</a>
        {% endif %}
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-6 py-12">
    <x-flash :flash="flash" />
    {% block content %}{% endblock %}
  </main>

  <footer class="mt-16 border-t border-stone-200">
    <div class="mx-auto max-w-3xl px-6 py-8 text-xs text-stone-400">
      <p class="font-serif text-sm text-stone-500">{{ app_title | default(value="RWFW") }}</p>
      <p class="mt-1">Words, quietly published.</p>
    </div>
  </footer>
</div>
{% endblock %}
