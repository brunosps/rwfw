{#def flash #}
{% if flash and flash.success %}<div class="mb-4 p-4 bg-green-100 text-green-700 rounded-md">{{ flash.success }}</div>{% endif %}
{% if flash and flash.error %}<div class="mb-4 p-4 bg-red-100 text-red-700 rounded-md">{{ flash.error }}</div>{% endif %}
{% if flash and flash.info %}<div class="mb-4 p-4 bg-blue-100 text-blue-700 rounded-md">{{ flash.info }}</div>{% endif %}
