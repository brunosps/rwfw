{#def name, label, type="text", value="", required=true #}
<div class="space-y-1.5">
  <label for="{{ name }}" class="block text-sm font-medium text-slate-700">
    {{ label }}{% if required %}<span class="ml-0.5 text-rose-500">*</span>{% endif %}
  </label>
  {% if type == "textarea" %}
  <textarea id="{{ name }}" name="{{ name }}" rows="10"
            class="block w-full rounded-lg border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:outline-none focus:ring-2 {% if errors[name] %}border-rose-300 focus:border-rose-500 focus:ring-rose-500/30{% else %}border-slate-300 focus:border-indigo-500 focus:ring-indigo-500/30{% endif %}"
            {% if required %}required{% endif %}>{{ value }}</textarea>
  {% else %}
  <input id="{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ value }}"
         class="block w-full rounded-lg border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:outline-none focus:ring-2 {% if errors[name] %}border-rose-300 focus:border-rose-500 focus:ring-rose-500/30{% else %}border-slate-300 focus:border-indigo-500 focus:ring-indigo-500/30{% endif %}"
         {% if required %}required{% endif %}>
  {% endif %}
  {% if errors[name] %}<p class="flex items-center gap-1 text-sm text-rose-600">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    {{ errors[name] }}
  </p>{% endif %}
</div>
