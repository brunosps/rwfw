{% extends "layouts/app.html.j2" %}
{% block title %}Components{% endblock %}
{% block content %}
<div class="max-w-4xl">
  <h1 class="text-3xl font-bold mb-2">Components</h1>
  <p class="text-gray-600 mb-8">{{ components | length }} component(s) discovered.</p>

  <div class="space-y-4">
    {% for c in components %}
    <div class="p-6 bg-white rounded-lg shadow-sm border">
      <h2 class="text-xl font-semibold font-mono">&lt;x-{{ c.name }}&gt;</h2>
      {% if c.props | length > 0 %}
      <table class="mt-3 text-sm w-full">
        <thead>
          <tr class="text-left text-gray-500"><th class="py-1">Prop</th><th class="py-1">Default</th></tr>
        </thead>
        <tbody>
          {% for p in c.props %}
          <tr class="border-t">
            <td class="py-1 font-mono">{{ p.name }}</td>
            <td class="py-1 font-mono text-gray-500">{{ p.default | default("—") }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="mt-2 text-sm text-gray-400">No declared props.</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
